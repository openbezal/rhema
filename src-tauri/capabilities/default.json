{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "broadcast-*"
  ],
  "permissions": [
    "core:default",
    "store:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/openbezal/rhema/*"
        }
      ]
    }
  ]
}
